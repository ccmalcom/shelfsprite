    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "swr": "^2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
