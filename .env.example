# ShelfSprite environment — copy to .env and fill in. .env is gitignored.
#
# LOCAL MODE: leave the Supabase vars below unset AND set ALLOW_LOCAL_AUTH=true. The app then
# runs single-user, with every request served as the "local" admin. The opt-in is deliberate:
# absent Supabase variables alone are treated as a configuration error, not as "auth off", so a
# deploy that loses a variable fails closed instead of handing out admin access. ALLOW_LOCAL_AUTH
# is never honoured when NODE_ENV=production. DATABASE_URL is still required — there is no SQLite
# fallback.

# --- local single-user ---
ALLOW_LOCAL_AUTH=true
ANTHROPIC_API_KEY=
GOOGLE_BOOKS_API_KEY=          # optional; bundled shared key in hosted mode
# MYLIBRARY_MODEL=claude-sonnet-5
# MYLIBRARY_REQ_PER_SEC=8

# --- web distribution (hosted multi-tenant mode) ---
# DATABASE_URL is required; the Node backend has no SQLite fallback.
# Use the Supabase SESSION POOLER string (host aws-0-<region>.pooler.supabase.com, port 5432):
# it's IPv4 and supports DDL. Avoid the direct connection (IPv6-only).
# Write a PLAIN postgresql:// URL — lib/server/db.ts connects with postgres-js, which rejects
# SQLAlchemy-style driver suffixes such as +psycopg (that form was for the retired Python app).
# URL-encode special chars in the password (@ -> %40, etc.).
# Deployment and migration steps: docs/hosting.md
# DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase auth. New projects sign access tokens with ES256 (asymmetric): the backend
# verifies against the project's PUBLIC key from the JWKS endpoint — no shared secret.
# Set SUPABASE_URL (the project URL, e.g. https://abc123.supabase.co); the JWKS URL is derived
# as <SUPABASE_URL>/auth/v1/.well-known/jwks.json and the expected token issuer (`iss`) as
# <SUPABASE_URL>/auth/v1.
#
# Setting ANY of these means hosted auth is intended, and the set must then be COMPLETE: a project
# URL plus NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY. A partial set answers 503 rather than quietly
# falling back to local mode. See docs/hosting.md, "The auth-mode decision (fail-closed)".
# SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=            # public fallback for the project URL
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # browser + page-middleware key; required with the above
# SUPABASE_JWKS_URL=          # optional explicit override of the derived JWKS URL
# SUPABASE_JWT_ISSUER=        # optional explicit override of the expected `iss` claim

# Base64 32-byte key for AES-256-GCM encryption of each user's Anthropic key at rest.
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# ENCRYPTION_KEY=

# Redis URL for the arq background job queue (Phase 4 — enrichment runs as a background job).
# Upstash Redis (recommended for Railway): rediss://<user>:<token>@<host>.upstash.io:6379
# Local Redis: redis://localhost:6379
# When unset: enrichment falls back to FastAPI BackgroundTasks (fine for local dev; no Redis needed).
# REDIS_URL=

# The deployed frontend's own origin (no trailing slash). Used to build the redirect_to for
# Supabase invite emails (-> <FRONTEND_URL>/auth/callback), so invited users land somewhere
# that actually establishes their session and prompts for a password — instead of falling back
# to the project's dashboard-configured Site URL, which may point at the wrong environment.
# When unset: invite_user() omits redirect_to and Supabase falls back to its Site URL setting.
# FRONTEND_URL=https://shelfsprite.app

# Beta feedback
FEEDBACK_PROMPTS_ENABLED=true   # set to false post-beta to silence targeted prompts (general surface stays on)
FEEDBACK_SNOOZE_HOURS=72        # hours before a snoozed prompt re-surfaces
CRON_SECRET=

# GitHub issue integration for the admin Feedback tab. Only GITHUB_TOKEN is required to
# enable issue creation; the other three have working defaults.
# Fine-grained PAT scoped to the repo with Issues: Read and write. When unset, the admin
# console reports github_configured: false and hides the create-issue action.
# GITHUB_TOKEN=
# GITHUB_REPO=ccmalcom/shelfsprite      # default; must match the webhook's repository.full_name exactly
# GITHUB_WEBHOOK_SECRET=                # required for POST /api/github/webhook; unset -> 503, never an unverified accept
# GITHUB_IN_PROGRESS_LABEL=in progress  # default; matched case-insensitively on the issues.labeled event
